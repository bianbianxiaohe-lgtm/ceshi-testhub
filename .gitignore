docker_cleanup_compact.ps1

# 墨刀样本素材（本地演示用，不入库）
media/modao_samples/

# 本地 AI 助手技能与临时脚本
.codebuddy/skills/
_fake_mig.py
nul; Write-Output cleaned

# 一次性排查/修复脚本及其输出（根目录 _ 前缀，全部为本地临时产物，禁止入库）
/_*.py
/_*.txt
/_*.tar
/_*.jpg
/_*.json
/_*.out
.debug_tmps/
frontend/_build_out.txt
frontend/_build_err.txt
