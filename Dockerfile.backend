#
# 2026-10-10: system deps now live in the BASE image, not in this file.
#   testhub-backend-base:20261010 already contains:
#     - python:3.12-slim (digest-pinned)
#     - apt packages (mysqlclient / build-essential / OpenCV GL libs / wget / unzip)
#     - adb client
#     - all 243 pip packages from requirements.lock.txt
#     - Playwright Chromium + its apt deps (~184MB browser)
#   Result: a code-only rebuild is `FROM` a local image + COPY . . => ~30 seconds,
#   and it no longer depends on BuildKit's cache surviving (the layers are IN the image).
#
# ---- WHEN TO REBUILD THE BASE IMAGE (NOT for code changes) -------------------------
#   Only when one of these changes:
#     - requirements.lock.txt            (else new packages are missing at runtime)
#     - system packages / playwright version
#     - python base image                (re-pin the digest)
#   Steps:
#     python scripts/gen_backend_base.py                       # regenerates base Dockerfile
#     docker build -f Dockerfile.backend-base -t testhub-backend-base:<YYYYMMDD> .
#     docker tag   testhub-backend-base:<YYYYMMDD> testhub-backend-base:latest
#     # then bump the FROM tag below and: docker compose build backend
#
#   !! Dockerfile.backend-base is GENERATED and its dependency lines are byte-identical
#      to Dockerfile.backend's originals on purpose. A single byte difference turns into
#      a CACHE MISS that re-resolves all 243 pip packages (hit on 2026-10-10). Do not
#      hand-edit those lines; change scripts/gen_backend_base.py instead.
# -----------------------------------------------------------------------------------
#
# (The dependency layers that used to live here are preserved in git history and in
#  Dockerfile.backend-base.)

FROM testhub-backend-base:20261010

# 复制项目代码
COPY . .

# 创建必要目录
RUN mkdir -p logs media allure static

EXPOSE 8000

# 启动脚本：等待MySQL就绪后执行迁移并启动
CMD ["python", "docker_start.py"]
